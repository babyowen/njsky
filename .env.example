# ====== 基础配置（南京默认，一般无需修改） ======
# 观测城市（SunsetBot 查询名，格式：省份-城市）
SUNSETBOT_CITY=江苏省-南京
# 观测点经纬度（Open-Meteo / suncalc 用）
CITY_LAT=32.0603
CITY_LON=118.7969
CITY_NAME=南京
# 时区（IANA 名称）
TZ_NAME=Asia/Shanghai

# ====== 可选数据源（不配也能跑，配了更准） ======
# 星图云（中科星图）火烧云官方 API token（付费产品，留空自动跳过）
GEOVIS_TOKEN=

# ====== 达标提醒（飞书单聊，可选） ======
# 飞书自建应用凭证：开发者后台 → 你的应用 → 凭证与基础信息
#   App Secret 是密钥，切勿提交到仓库；bot 身份靠它自动换 token，不会过期
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 接收人 open_id（lark-cli contact +get-user 可查自己，ou_ 开头）
FEISHU_USER_ID=
# 触发阈值（0-2.5 指数，默认 0.1963 = 小到中烧及以上）
PUSH_THRESHOLD=0.1963

# ====== 管理接口密钥 ======
# POST /api/admin/refresh（手动触发采集）和 /api/admin/push-test（测试推送）需要携带此密钥
ADMIN_SECRET=

# ====== 存储路径（默认即可） ======
# DB_PATH=./data/njsky.db
